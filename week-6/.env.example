# ==============================================================================
# ZYROO AI DOCUMENT INTELLIGENCE & WORKFLOW PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Rename this file to .env and adjust variables as required.

# Server & Runtime
ZYROO_ENV=production
ZYROO_LOG_LEVEL=INFO
ZYROO_ENABLE_PROFILING=true

# Storage & Database
ZYROO_DB_FILE=workflow_repository.db
ZYROO_STORAGE_DIR=storage

# Security & Constraints
ZYROO_MAX_FILE_SIZE_BYTES=26214400 # 25 MB
ZYROO_API_SECRET=your-secure-production-api-secret-key-here

# Workflow & Thresholds
ZYROO_CONFIDENCE_THRESHOLD=0.75
ZYROO_HIGH_VALUE_THRESHOLD=10000.0
ZYROO_ARITHMETIC_TOLERANCE=0.05

# RAG & Semantic Retrieval
ZYROO_RAG_CHUNK_SIZE=350
ZYROO_RAG_CHUNK_OVERLAP=60
ZYROO_RAG_TOP_K=4
ZYROO_RAG_MIN_SIMILARITY=0.15

# Optional External AI API Keys (Leave blank to use built-in grounded extractive engine)
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
